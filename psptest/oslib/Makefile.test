PSPTEST_SOURCE_DIR := $(patsubst %/,%,$(dir $(abspath $(firstword $(MAKEFILE_LIST)))))

ifeq ($(abspath $(CURDIR)),$(PSPTEST_SOURCE_DIR))
$(error PSPTEST generated files may not be written into the source directory; build through PSPDEV stage 6 or use a separate build directory)
endif

TARGET = psptest-oslib$(if $(VARIANT),-$(VARIANT),)
OBJS = main.o

XMP ?= lite
PROFILE ?= baseline

ifeq ($(XMP),lite)
XMP_LIB = -lxmp-lite
else ifeq ($(XMP),full)
XMP_LIB = -lxmp
else
$(error XMP must be "lite" or "full")
endif

PROFILE_CFLAGS =
PROFILE_LDFLAGS =

ifeq ($(PROFILE),gc)
PROFILE_CFLAGS += -ffunction-sections -fdata-sections
PROFILE_LDFLAGS += -Wl,--gc-sections
else ifeq ($(PROFILE),lto-gc)
PROFILE_CFLAGS += -flto -ffunction-sections -fdata-sections
PROFILE_LDFLAGS += -flto -Wl,--gc-sections
else ifneq ($(PROFILE),baseline)
$(error PROFILE must be "baseline", "gc", or "lto-gc")
endif

CFLAGS = -O2 -G0 -Wall -Wextra -Werror $(PROFILE_CFLAGS)
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)
LDFLAGS = $(PROFILE_LDFLAGS) -Wl,-Map,$(TARGET).map

LIBS = -losl $(XMP_LIB) -lpng -lz -lm -ljpeg -lpsptest \
       -lpspgum -lpspaudiolib \
       -lpsphprm -lpspumd -lpsprtc -lpsppower -lpspgu -lpspaudio \
       -lpsphttp -lpspssl -lpspwlan -lpspaudiocodec \
       -lpspnet_adhocmatching -lpspnet_adhoc -lpspnet_adhocctl

BUILD_PRX = 1
PRX_EXPORTS ?= ../psptest.exp

PSPSDK := $(shell psp-config --pspsdk-path)
PSPTEST_FRAMEWORK_INCDIR ?= $(PSPSDK)/include
PSPTEST_FRAMEWORK_LIBDIR ?= $(PSPSDK)/lib
INCDIR += $(PSPTEST_FRAMEWORK_INCDIR)
LIBDIR += $(PSPTEST_FRAMEWORK_LIBDIR)

include $(PSPSDK)/lib/build.mak

PSP_SIZE ?= psp-size
PSP_NM ?= psp-nm

.PHONY: matrix matrix-clean

matrix:
	@echo "ERROR: matrix builds must use a separate ignored build directory." >&2
	@false

matrix-clean:
	@echo "ERROR: matrix-clean is obsolete; generated files must never be written into the source directory." >&2
	@false
