pkgname=xxhash
pkgver=0.8.2
pkgrel=5
pkgdesc="Extremely fast non-cryptographic hash algorithm"
arch=(any)
url="https://xxhash.com/"
license=('BSD-2-Clause')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=()
sha256sums=()

prepare() {
    rm -rf "$srcdir/xxHash-$pkgver"
    cp -a "$startdir/../components/xxhash" "$srcdir/xxHash-$pkgver"
    rm -rf "$srcdir/xxHash-$pkgver/.git"
}

build() {
    cd "$srcdir/xxHash-$pkgver"
    mkdir -p build-psp
    cmake -Wno-author \
        -S build/cmake \
        -B build-psp \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DXXHASH_BUILD_XXHSUM=OFF \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build-psp -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$srcdir/xxHash-$pkgver"
    DESTDIR="$pkgdir" cmake --install build-psp

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
