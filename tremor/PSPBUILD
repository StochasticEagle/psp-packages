pkgname=tremor
pkgver=1.2.1git20250403
pkgrel=1
pkgdesc="Integer-only, fully Ogg Vorbis compliant software decoder library"
arch=(any)
url="https://wiki.xiph.org/Tremor"
license=('BSD-3-Clause')
groups=('psp-libraries')
depends=('libogg')
makedepends=()
optdepends=()
source=("git+https://gitlab.xiph.org/xiph/tremor.git#branch=main")
sha256sums=('SKIP')

prepare() {
    cd "${pkgname}"

    sed -i 's#@prefix@#${PSPDEV}/psp#' vorbisidec.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' vorbisidec.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' vorbisidec.pc.in
    sed -i 's#@includedir@#${prefix}/include#' vorbisidec.pc.in
}

build() {
    cd "${pkgname}"

    # Current upstream autogen.sh only regenerates the autotools files; it no
    # longer runs configure itself.
    ./autogen.sh

    # Keep PSP/Allegrex policy in the package recipe rather than patching
    # upstream configure.ac. Tremor's configure script appends caller CFLAGS to
    # its normal GCC flags, and --enable-low-accuracy supplies _LOW_ACCURACY_.
    LDFLAGS="-L$(psp-config --pspsdk-path)/lib" \
    LIBS="-lc -lpspuser" \
    CFLAGS="-G0 -DLITTLE_ENDIAN=1 -DBYTE_ORDER=LITTLE_ENDIAN -Wno-error=incompatible-pointer-types" \
    ./configure --host=psp --prefix=/psp --enable-low-accuracy

    make
}

package() {
    cd "${pkgname}"
    make DESTDIR="$pkgdir/" install

    rm "${pkgdir}/psp/lib/libvorbisidec.la"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}
