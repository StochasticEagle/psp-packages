pkgname=unarr
pkgver=1.1.1
pkgrel=4
pkgdesc="A decompression library for rar, tar, zip and 7z archives"
arch=(any)
url="https://github.com/selmf/unarr/"
license=('LGPL-3.0')
groups=('psp-libraries')
depends=()
optdepends=('zlib' 'bzip2' 'liblzma')
makedepends=()
source=(
    "${pkgname}-${pkgver}::git+https://github.com/selmf/unarr.git#branch=master"
)
sha256sums=(
    "SKIP"
)

prepare() {
    cd "${pkgname}-${pkgver}"
}

build() {
    cd "${pkgname}-${pkgver}"
    mkdir -p build
    cd build
    cmake -Wno-dev -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" -DCMAKE_INSTALL_PREFIX="${pkgdir}/psp" \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5 "${XTRA_OPTS[@]}" .. || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}/build"
    make --quiet $MAKEFLAGS install
    cd ..
    mkdir -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 COPYING "${pkgdir}/psp/share/licenses/${pkgname}"
}
