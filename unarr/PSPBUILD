pkgname=unarr
pkgver=1.1.1
pkgrel=6
pkgdesc="A decompression library for rar, tar, zip and 7z archives"
arch=(any)
url="https://github.com/selmf/unarr/"
license=('LGPL-3.0')
groups=('psp-libraries')
depends=()
optdepends=('zlib' 'bzip2' 'liblzma')
makedepends=()
source=(
    "${pkgname}-${pkgver}::git+https://github.com/selmf/unarr.git#branch=master"
)
sha256sums=(
    "SKIP"
)

prepare() {
    cd "${pkgname}-${pkgver}"

    # newlib can fail to expose the 64-bit PRI* format macros when its internal
    # stdint definitions are first reached indirectly. Force those definitions
    # in before unarr's headers pull in <inttypes.h>.
    sed -i '/^#include <inttypes.h>$/d' _7z/_7z.c
    if ! grep -q '^#include <sys\/_stdint.h>$' _7z/_7z.c; then
        sed -i '/^#include "_7z.h"$/i #include <sys/_stdint.h>' _7z/_7z.c
    fi
}

build() {
    cd "${pkgname}-${pkgver}"
    rm -rf build
    cmake -S . -B build \
        -Wno-author \
        -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX="${pkgdir}/psp" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    cmake --install build || { exit 1; }

    mkdir -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 COPYING "${pkgdir}/psp/share/licenses/${pkgname}"
}
