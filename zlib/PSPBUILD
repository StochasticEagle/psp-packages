pkgname=zlib
pkgver=1.3.2
pkgrel=1
pkgdesc="Compression library implementing the deflate compression method found in gzip and PKZIP"
arch=(any)
url="https://www.zlib.net/"
license=('Zlib')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("${pkgname}-${pkgver}::git+https://github.com/madler/zlib.git#branch=master")
sha256sums=('SKIP')

build() {
    cd "${pkgname}-${pkgver}"
    rm -rf build

    cmake -S . -B build \
        -Wno-author \
        -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DZLIB_BUILD_SHARED=OFF \
        -DZLIB_BUILD_STATIC=ON \
        -DZLIB_BUILD_TESTING=OFF \
        -DZLIB_INSTALL=ON \
        -DUNIX:BOOL=ON \
        -DCMAKE_BUILD_TYPE=Release \
        "${XTRA_OPTS[@]}" || { exit 1; }

    cmake --build build -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    DESTDIR="${pkgdir}" cmake --install build || { exit 1; }

    mkdir -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 README "${pkgdir}/psp/share/licenses/${pkgname}"

    # Install documentation
    mkdir -p "${pkgdir}/psp/share/doc/"
    cp -r doc "${pkgdir}/psp/share/doc/${pkgname}"
}
