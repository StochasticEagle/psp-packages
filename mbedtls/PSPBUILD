pkgname=mbedtls
pkgver=4.2.0
pkgrel=3
pkgdesc="Secure Socket Layer library"
arch=(any)
url="https://www.trustedfirmware.org/projects/mbed-tls/"
license=('Apache-2.0')
groups=('psp-libraries')
depends=()
optdepends=()
makedepends=()
source=()
sha256sums=()

prepare() {
    rm -rf "$srcdir/$pkgname-$pkgver"
    cp -a "$startdir/../components/mbedtls" "$srcdir/$pkgname-$pkgver"

    # The parent source is a shallow submodule and Mbed TLS 4.x contains
    # framework and TF-PSA-Crypto submodules. Strip Git metadata only from the
    # disposable build copy; the checked-out components tree remains pristine.
    find "$srcdir/$pkgname-$pkgver" -name .git -exec rm -rf {} + 2>/dev/null || true

    cd "$srcdir/$pkgname-$pkgver"
    patch --batch --forward -p1 < "$startdir/mbedtls-$pkgver-PSP.patch" || { exit 1; }
}

build() {
    cmake -Wno-author \
        -S "$srcdir/$pkgname-$pkgver" \
        -B "$srcdir/$pkgname-$pkgver/build" \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_TESTING=OFF \
        -DENABLE_PROGRAMS=OFF \
        -DUSE_STATIC_MBEDTLS_LIBRARY=ON \
        -DUSE_SHARED_MBEDTLS_LIBRARY=OFF \
        "${XTRA_OPTS[@]}" || { exit 1; }

    cmake --build "$srcdir/$pkgname-$pkgver/build" -- $MAKEFLAGS || { exit 1; }
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/$pkgname-$pkgver/build" || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/psp/share/licenses/$pkgname"
}
