pkgname=sdl-ttf
pkgver=2.0.11
pkgrel=13
pkgdesc="A companion library to SDL for working with TrueType (tm) fonts"
arch=(any)
url="https://www.libsdl.org/projects/old/SDL_ttf/release-1.2.html"
license=('Zlib')
groups=('psp-libraries')
depends=('sdl' 'freetype2')
makedepends=()
optdepends=()
source=("SDL_ttf-${pkgver}-psp::git+https://github.com/pspdev/SDL_ttf.git#commit=65da6a18b7b7f89ac67473e11311a21c1ea22de0")
psp_source_components=([0]="components/SDL_ttf12")
sha256sums=('SKIP')

prepare() {
    cd "SDL_ttf-$pkgver-psp"
    sed -i 's#@prefix@#/psp#' SDL_ttf.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' SDL_ttf.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' SDL_ttf.pc.in
    sed -i 's#@includedir@#${prefix}/include#' SDL_ttf.pc.in
}

build() {
    cd "SDL_ttf-$pkgver-psp"
    ./autogen.sh
    CFLAGS="$("${PKG_CONFIG:-pkg-config}" --static --cflags freetype2 libpng zlib)" \
    LDFLAGS="-L$(psp-config --pspsdk-path)/lib -L$(psp-config --psp-prefix)/lib -lc -lpspuser" \
    LIBS="$("${PKG_CONFIG:-pkg-config}" --static --libs freetype2 libpng zlib) -lpspvfpu -lc -lpspuser" \
    ./configure --host psp --prefix=/psp --with-sdl-prefix=$(psp-config --psp-prefix) \
    --with-freetype-prefix=$(psp-config --psp-prefix) --without-x
    make libSDL_ttf.la
}

package() {
    cd "SDL_ttf-$pkgver-psp"
    make DESTDIR="$pkgdir/" install-libLTLIBRARIES install-libSDL_ttfincludeHEADERS install-pkgconfigDATA

    rm "${pkgdir}/psp/lib/libSDL_ttf.la"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname/COPYING"
}
