pkgname=sdl3-gfx
pkgver=r21.0bbee98
pkgrel=4
pkgdesc="Graphics drawing primitives and other support functions wrapped up in an add-on, C-based library for the Simple Direct Media (SDL) cross-platform API layer"
arch=('any')
url="https://github.com/sabdul-khabir/SDL3_gfx"
license=('Zlib')
groups=(psp-libraries)
depends=(sdl3)
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
replaces=()
backup=()
options=()
install=
changelog=
source=("cmake-module.patch"
        "psp.patch")
noextract=()
sha256sums=('e0d3a84262a4892554277184429205b91e8e1f2f2d0fe31150504f9c5a427fc8'
            'a53b5251727170ae04de51bd5098c7b4d36507e1a71a2952ab5cd78a04cef0d3')
validpgpkeys=()

prepare() {
        rm -rf "$srcdir/${pkgname%-git}"
        cp -a "$startdir/../components/sdl3-gfx" "$srcdir/${pkgname%-git}"
        rm -rf "$srcdir/${pkgname%-git}/.git"

        cd "$srcdir/${pkgname%-git}"

        # PR #22 creates this file. Remove a stale copy if prepare() is rerun
        # against an existing package source tree.
        rm -f SDL3_gfxConfig.cmake.in

        patch --batch --forward -Np1 -i "$srcdir/cmake-module.patch"
        patch --batch --forward -Np1 -i "$srcdir/psp.patch"

        # patch sdl3-gfx.pc.in
        sed -i 's/@CMAKE_INSTALL_PREFIX@/${PSPDEV}\/psp/g' ./sdl3-gfx.pc.in
        sed -i 's/@CMAKE_INSTALL_FULL_LIBDIR@/${PSPDEV}\/psp\/lib/g' ./sdl3-gfx.pc.in
        sed -i 's/@CMAKE_INSTALL_FULL_INCLUDEDIR@/${PSPDEV}\/psp\/include/g' ./sdl3-gfx.pc.in
}

build() {
        cmake -S "$srcdir/${pkgname%-git}" -B build \
                -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake \
                -DCMAKE_INSTALL_PREFIX=/psp \
                -DCMAKE_BUILD_TYPE=Release \
                -DBUILD_SHARED_LIBS=OFF

        cmake --build build
}

package() {
        DESTDIR="$pkgdir" cmake --install build
        install -Dm644 -t "$pkgdir"/psp/share/licenses/$pkgname "$srcdir/${pkgname%-git}/COPYING"
}
