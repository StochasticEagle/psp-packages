pkgrel=6
pkgdesc="Graphics drawing primitives and other support functions wrapped up in an add-on, C-based library for the Simple Direct Media (SDL) cross-platform API layer"
arch=('any')
url="https://github.com/sabdul-khabir/SDL3_gfx"
license=('Zlib')
groups=(psp-libraries)
depends=(sdl3)
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
replaces=()
backup=()
options=()
install=
changelog=
source=(
        "sdl3-gfx::git+https://github.com/sabdul-khabir/SDL3_gfx.git#commit=0bbee988bb0caa3e98a9d78c7a2d106925c8275a"
        "cmake-module.patch"
        "psp.patch")
noextract=()
sha256sums=('SKIP'
            'e0d3a84262a4892554277184429205b91e8e1f2f2d0fe31150504f9c5a427fc8'
            'a53b5251727170ae04de51bd5098c7b4d36507e1a71a2952ab5cd78a04cef0d3')
validpgpkeys=()

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
        cd "$srcdir/${pkgname%-git}"

        rm -f SDL3_gfxConfig.cmake.in

        psp_apply_patch "$srcdir/cmake-module.patch" -Np1
        psp_apply_patch "$srcdir/psp.patch" -Np1

        sed -i 's/@CMAKE_INSTALL_PREFIX@/\/psp/g' ./sdl3-gfx.pc.in
        sed -i 's/@CMAKE_INSTALL_FULL_LIBDIR@/\/psp\/lib/g' ./sdl3-gfx.pc.in
        sed -i 's/@CMAKE_INSTALL_FULL_INCLUDEDIR@/\/psp\/include/g' ./sdl3-gfx.pc.in
}

build() {
        cmake -S "$srcdir/${pkgname%-git}" -B build \
                -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake \
                -DCMAKE_INSTALL_PREFIX=/psp \
                -DCMAKE_BUILD_TYPE=Release \
                -DBUILD_SHARED_LIBS=OFF

        cmake --build build
}

package() {
        DESTDIR="$pkgdir" cmake --install build
        install -Dm644 -t "$pkgdir"/psp/share/licenses/$pkgname "$srcdir/${pkgname%-git}/COPYING"
}
