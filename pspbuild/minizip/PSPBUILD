pkgname=minizip
pkgver=4.2.2
pkgrel=2
pkgdesc="Fork of the popular zip manipulation library found in the zlib distribution"
arch=(any)
url="https://github.com/zlib-ng/minizip-ng"
license=('Zlib')
groups=('psp-libraries')
depends=('zlib' 'bzip2')
makedepends=()
optdepends=()
source=("minizip-ng-$pkgver::git+https://github.com/zlib-ng/minizip-ng.git#commit=86dd3e2b5628125dc6a7d17287187c0732d1bc70")
sha256sums=('SKIP')

prepare() {
  cd minizip-ng-$pkgver
  sed -i '/POSITION_INDEPENDENT_CODE/d' CMakeLists.txt
  sed -i 's#@CMAKE_INSTALL_PREFIX@#/psp#g' minizip.pc.cmakein
  sed -i 's#@CMAKE_INSTALL_FULL_LIBDIR@#${prefix}/lib#g' minizip.pc.cmakein
  sed -i 's#@CMAKE_INSTALL_FULL_INCLUDEDIR@#${prefix}/include#' minizip.pc.cmakein
}

build() {
  cd minizip-ng-$pkgver
  mkdir -p build
  cd build
  cmake -Wno-dev -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake -DCMAKE_INSTALL_PREFIX=/psp -DBUILD_SHARED_LIBS=OFF \
      -DMZ_COMPAT=OFF \
      -DMZ_LZMA=OFF \
      -DMZ_OPENSSL=OFF \
      -DMZ_ZSTD=OFF \
      -DMZ_PPMD=OFF \
      -DMZ_ICONV=OFF \
      -DMZ_LIBBSD=OFF \
      -DMZ_FETCH_LIBS=OFF \
      -DMZ_BUILD_TESTS=OFF \
      -DMZ_BUILD_UNIT_TESTS=OFF \
      -DMZ_BUILD_FUZZ_TESTS=OFF \
      "${XTRA_OPTS[@]}" -DCMAKE_BUILD_TYPE=Release .. || { exit 1; }
  make --quiet $MAKEFLAGS || { exit 1; }
}

package () {
  cd minizip-ng-$pkgver/build
  make --quiet DESTDIR=$pkgdir $MAKEFLAGS install

  mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
  install -m 644 ../LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
