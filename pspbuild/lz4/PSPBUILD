pkgname=lz4
pkgver=1.10.0
pkgrel=1
pkgdesc="Extremely Fast Compression algorithm"
arch=(any)
url="https://lz4.org/"
license=('BSD-2-Clause')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("$pkgname-$pkgver::git+https://github.com/lz4/lz4.git#commit=0774d05537f9762f838f7ab541b7765f1a729cb5")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"

    sed -i 's#@PREFIX@#/psp#' lib/liblz4.pc.in

    # can't disable building all the programs, so just delete them
    rm programs/*.c
}

build() {
    cd "$pkgname-$pkgver"
    mkdir -p build/psp
    cd build/psp
    cmake -Wno-dev -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake -DCMAKE_INSTALL_PREFIX=${pkgdir}/psp -DBUILD_SHARED_LIBS=OFF \
        -DBUILD_STATIC_LIBS=ON -DLZ4_POSITION_INDEPENDENT_LIB=OFF -DLZ4_BUILD_CLI=OFF -DLZ4_BUILD_LEGACY_LZ4C=OFF \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 "${XTRA_OPTS[@]}" ../cmake || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$pkgname-$pkgver/build/psp"
    make --quiet $MAKEFLAGS install
    cd ../../lib

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
