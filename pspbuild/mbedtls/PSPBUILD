pkgname=mbedtls
pkgver=4.2.0
pkgrel=9
pkgdesc="Secure Socket Layer library"
arch=(any)
url="https://www.trustedfirmware.org/projects/mbed-tls/"
license=('Apache-2.0')
groups=('psp-libraries')
depends=()
optdepends=()
makedepends=()
source=("mbedtls-${pkgver}::git+https://github.com/Mbed-TLS/mbedtls.git#commit=ece41aa84d7879d7e55c59e955a5884b541f7f3b")
sha256sums=('SKIP')

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    if ! python3 -c 'import jinja2, jsonschema' >/dev/null 2>&1; then
        echo "ERROR: mbedtls requires the host Python modules jinja2 and jsonschema." >&2
        exit 1
    fi

    netdb_header="${PSPDEV}/psp/include/netdb.h"
    if [[ ! -f "${netdb_header}" ]] ||
       ! grep -q 'struct addrinfo' "${netdb_header}" ||
       ! grep -q 'getaddrinfo' "${netdb_header}" ||
       ! grep -q 'AI_PASSIVE' "${netdb_header}"; then
        echo "ERROR: Installed PSP sysroot has a stale or incomplete netdb.h." >&2
        echo "Rebuild/install the current PSP toolchain/newlib before building mbedtls." >&2
        exit 1
    fi

    cd "$srcdir/$pkgname-$pkgver"
    psp_apply_patch "$startdir/mbedtls-$pkgver-PSP.patch" -p1 || { exit 1; }
}

build() {
    cmake -Wno-author \
        -S "$srcdir/$pkgname-$pkgver" \
        -B "$srcdir/$pkgname-$pkgver/build" \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_TESTING=OFF \
        -DENABLE_PROGRAMS=OFF \
        -DUSE_STATIC_MBEDTLS_LIBRARY=ON \
        -DUSE_SHARED_MBEDTLS_LIBRARY=OFF \
        "${XTRA_OPTS[@]}" || { exit 1; }

    cmake --build "$srcdir/$pkgname-$pkgver/build" -- $MAKEFLAGS || { exit 1; }
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/$pkgname-$pkgver/build" || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/psp/share/licenses/$pkgname"
}
