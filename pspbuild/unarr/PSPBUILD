pkgname=unarr
pkgver=1.1.1
pkgrel=7
pkgdesc="A decompression library for rar, tar, zip and 7z archives"
arch=(any)
url="https://github.com/selmf/unarr/"
license=('LGPL-3.0')
groups=('psp-libraries')
depends=()
optdepends=('zlib' 'bzip2' 'liblzma')
makedepends=()
source=(
    "${pkgname}-${pkgver}::git+https://github.com/selmf/unarr.git#branch=master"
)
sha256sums=(
    "SKIP"
)

prepare() {
    cd "${pkgname}-${pkgver}"

    # The currently installed PSP GCC can provide its own stdint.h before
    # newlib's header, leaving newlib's internal __int64_t_defined marker unset.
    # unarr's private implementation header is shared by all archive backends,
    # so establish newlib's integer definitions before unarr.h includes stdint.h.
    if ! grep -qxF '#include <sys/_stdint.h>' common/unarr-imp.h; then
        sed -i '/^#include "unarr.h"$/i #include <sys/_stdint.h>' common/unarr-imp.h
    fi
}

build() {
    cd "${pkgname}-${pkgver}"
    rm -rf build
    cmake -S . -B build \
        -Wno-author \
        -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX="${pkgdir}/psp" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    cmake --install build || { exit 1; }

    mkdir -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 COPYING "${pkgdir}/psp/share/licenses/${pkgname}"
}
