pkgname=unarr
pkgver=1.2.0
pkgrel=2
pkgdesc="A decompression library for rar, tar, zip and 7z archives"
arch=(any)
url="https://github.com/selmf/unarr/"
license=('LGPL-3.0')
groups=('psp-libraries')
depends=()
optdepends=('zlib' 'bzip2' 'liblzma')
makedepends=()
source=(
    "${pkgname}-${pkgver}::git+https://github.com/selmf/unarr.git#commit=3307cd3fdcffe3b98326872c601bbf7235386441"
    "unarr-1.2.0-PSP.patch"
)
sha256sums=(
    "SKIP"
    "SKIP"
)

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd "${pkgname}-${pkgver}"
    psp_apply_patch "$startdir/unarr-1.2.0-PSP.patch" -p1 || { exit 1; }

    # Disable upstream target-level IPO/LTO. PSP consumers link this as a
    # conventional static archive, and the LTO-only objects require GCC's LTO
    # plugin at every consumer link.
    if ! grep -qF 'set_target_properties(unarr PROPERTIES INTERPROCEDURAL_OPTIMIZATION TRUE)' CMakeLists.txt; then
        echo "ERROR: Expected unarr IPO setting not found." >&2
        return 1
    fi
    sed -i 's/set_target_properties(unarr PROPERTIES INTERPROCEDURAL_OPTIMIZATION TRUE)/set_target_properties(unarr PROPERTIES INTERPROCEDURAL_OPTIMIZATION FALSE)/' CMakeLists.txt

    # The currently installed PSP GCC can provide its own stdint.h before
    # newlib's header, leaving newlib's internal __int64_t_defined marker unset.
    # unarr's private implementation header is shared by all archive backends,
    # so establish newlib's integer definitions before unarr.h includes stdint.h.
    if ! grep -qxF '#include <sys/_stdint.h>' common/unarr-imp.h; then
        sed -i '/^#include "unarr.h"$/i #include <sys/_stdint.h>' common/unarr-imp.h
    fi
}

build() {
    cd "${pkgname}-${pkgver}"
    rm -rf build
    cmake -S . -B build \
        -Wno-author \
        -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 COPYING "${pkgdir}/psp/share/licenses/${pkgname}"
}
