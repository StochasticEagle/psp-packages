pkgname=harfbuzz
pkgver=14.4.0
pkgrel=6
pkgdesc="OpenType text shaping engine"
arch=(any)
url="https://harfbuzz.github.io/"
license=('MIT')
depends=('freetype2')
groups=('psp-libraries')
makedepends=()
optdepends=()
source=(
  "harfbuzz-${pkgver}::git+https://github.com/harfbuzz/harfbuzz.git#commit=36cb489cb02ce4b92099669ba9f9bea348eff93f"
  "fix-cmake.patch"
)
sha256sums=(
  "SKIP"
  "SKIP"
)

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd "harfbuzz-${pkgver}/src"
    sed -i 's#%prefix%#/psp#' harfbuzz*.pc.in
    sed -i 's#%exec_prefix%#${prefix}#' harfbuzz*.pc.in
    sed -i 's#%libdir%#${prefix}/lib#' harfbuzz*.pc.in
    sed -i 's#%includedir%#${prefix}/include#' harfbuzz*.pc.in

    cd ..
    psp_apply_patch ../fix-cmake.patch -p1
}

build() {
    cd "harfbuzz-${pkgver}"
    cmake -S . -B build -Wno-author \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DHB_HAVE_FREETYPE=ON \
        -DHB_BUILD_UTILS=OFF \
        -DHB_BUILD_SUBSET=OFF \
        -DHB_BUILD_RASTER=OFF \
        -DHB_BUILD_VECTOR=OFF \
        -DHB_BUILD_GPU=OFF \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "harfbuzz-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}
