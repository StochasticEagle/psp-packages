pkgname=sqlite
pkgver=3.53.4
pkgrel=1
pkgdesc="SQLite is a C-language library that implements a small, fast, self-contained, high-reliability, full-featured SQL database engine"
arch=(any)
url="https://www.sqlite.org/"
license=('custom:Public-Domain')
groups=('psp-libraries')
depends=()
optdepends=()
makedepends=()
source=(
    "sqlite-version-${pkgver}::git+https://github.com/sqlite/sqlite.git#commit=b09c88c14082339b66c7b7158d609a771e64ca69"
    "sqlite3_psp_vfs.c"
)
psp_source_components=(
    [0]="components/sqlite"
)
sha256sums=(
    'SKIP'
    '3c1b775c94b5f360fc7727b9c67233a2ffc145d50ad6401759157c9b852a8338'
)

prepare() {
    cd "${srcdir}/sqlite-version-${pkgver}"

    # Generate the official amalgamation entirely from the pinned Git source.
    # SQLite carries its generator scripts and JimTCL bootstrap in-tree.
    ./configure || { exit 1; }
    make -j1 sqlite3.c || { exit 1; }
}

build() {
    cd "${srcdir}/sqlite-version-${pkgver}"

    local common_flags=(
        -G0 -O2 -std=c17
        -DSQLITE_OS_OTHER=1
        -DSQLITE_THREADSAFE=0
        -DSQLITE_OMIT_LOAD_EXTENSION=1
        -DSQLITE_TEMP_STORE=3
        -I.
        -I"$(psp-config --pspsdk-path)/include"
    )

    psp-gcc "${common_flags[@]}" -c sqlite3.c -o sqlite3.o || { exit 1; }
    psp-gcc "${common_flags[@]}" -c "${srcdir}/sqlite3_psp_vfs.c" -o sqlite3_psp_vfs.o || { exit 1; }
    psp-ar rcs libsqlite3.a sqlite3.o sqlite3_psp_vfs.o || { exit 1; }
    psp-ranlib libsqlite3.a || { exit 1; }
}

package() {
    cd "${srcdir}/sqlite-version-${pkgver}"

    install -d "$pkgdir/psp/include" "$pkgdir/psp/lib/pkgconfig"
    install -m 644 sqlite3.h sqlite3ext.h "$pkgdir/psp/include/"
    install -m 644 libsqlite3.a "$pkgdir/psp/lib/"

    cat > "$pkgdir/psp/lib/pkgconfig/sqlite3.pc" <<EOF
prefix=\${PSPDEV}/psp
exec_prefix=\${prefix}
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: SQLite
Description: SQL database engine
Version: ${pkgver}
Libs: -L\${libdir} -lsqlite3
Libs.private: -lpspuser -lc
Cflags: -I\${includedir}
EOF
}
