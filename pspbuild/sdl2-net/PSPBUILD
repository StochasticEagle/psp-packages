pkgname=sdl2-net
pkgver=2.2.0
pkgrel=11
pkgdesc="A wrapper over TCP/IP sockets"
arch=(any)
url="https://wiki.libsdl.org/SDL2_net/FrontPage"
license=('Zlib')
groups=('psp-libraries')
depends=('sdl2')
makedepends=()
optdepends=()
source=(
    "SDL2_net-${pkgver}::git+https://github.com/libsdl-org/SDL_net.git#commit=669e75b84632e2c6cc5c65974ec9e28052cb7a4e"
    "${pkgname}-${pkgver}-PSP.patch"
)
psp_source_components=([0]="components/SDL2_net")
sha256sums=(
    "SKIP"
    "SKIP"
)

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd "${srcdir}/SDL2_net-${pkgver}"
    sed -i '/^prefix=/s/=.*$/=\/psp/' SDL2_net.pc.in
    psp_apply_patch "../${pkgname}-${pkgver}-PSP.patch" -p1 || { exit 1; }
}

build() {
    cd "${srcdir}/SDL2_net-${pkgver}"
    mkdir -p build && cd build
    cmake -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=OFF -DSDL2NET_INSTALL=ON -DSDL2NET_SAMPLES=OFF \
        -DCMAKE_BUILD_TYPE=Release .. "${XTRA_OPTS[@]}" || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${srcdir}/SDL2_net-${pkgver}/build"
    make --quiet DESTDIR="${pkgdir}" ${MAKEFLAGS} install

    mv "${pkgdir}/psp/share/licenses/SDL2_net" "${pkgdir}/psp/share/licenses/${pkgname}"
}
