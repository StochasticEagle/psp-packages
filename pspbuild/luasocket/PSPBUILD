pkgname=luasocket
pkgver=3.1.0
pkgrel=2
pkgdesc="Network support for the Lua language"
arch=(any)
url="https://lunarmodules.github.io/luasocket/"
license=('MIT')
groups=()
depends=('lua55')
makedepends=()
optdepends=()
source=(
    "${pkgname}-${pkgver}::git+https://github.com/lunarmodules/luasocket.git#branch=master"
)
sha256sums=(
    'SKIP'
)

build() {
    cd "${pkgname}-${pkgver}"
    make PLAT=psp
}

package() {
    cd "${pkgname}-${pkgver}"
    make install-static DESTDIR="$pkgdir" PLAT=psp

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
