pkgname=luasocket
pkgver=3.1.0
pkgrel=8
pkgdesc="Network support for the Lua language"
arch=(any)
url="https://lunarmodules.github.io/luasocket/"
license=('MIT')
groups=('psp-libraries')
depends=('lua55')
makedepends=()
optdepends=()
source=(
    "${pkgname}-${pkgver}::git+https://github.com/StochasticEagle/psp-luasocket.git#commit=9eb66e033d5e92e89fb807647774bd1fc4f2b12a"
)
sha256sums=(
    'SKIP'
)

build() {
    cd "${pkgname}-${pkgver}"

    netdb_header="${PSPDEV}/psp/include/netdb.h"
    if [[ ! -f "${netdb_header}" ]] ||
       ! grep -q 'struct addrinfo' "${netdb_header}" ||
       ! grep -q 'NI_MAXHOST' "${netdb_header}" ||
       ! grep -q 'EAI_AGAIN' "${netdb_header}" ||
       ! grep -q 'gai_strerror' "${netdb_header}"; then
        echo "ERROR: Installed PSP netdb.h lacks the resolver API required by LuaSocket." >&2
        exit 1
    fi

    make PLAT=psp LUAV=5.5
}

package() {
    cd "${pkgname}-${pkgver}"
    make install-static DESTDIR="$pkgdir" PLAT=psp LUAV=5.5

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
