pkgname=luasocket
pkgver=3.1.0
pkgrel=6
pkgdesc="Network support for the Lua language"
arch=(any)
url="https://lunarmodules.github.io/luasocket/"
license=('MIT')
groups=('psp-libraries')
depends=('lua55')
makedepends=()
optdepends=()
source=(
    "${pkgname}-${pkgver}::git+https://github.com/StochasticEagle/psp-luasocket.git#commit=0f2e21f2ff0da02eba13b80480ca49cb47307376"
)
sha256sums=(
    'SKIP'
)

build() {
    cd "${pkgname}-${pkgver}"
    make PLAT=psp LUAV=5.5
}

package() {
    cd "${pkgname}-${pkgver}"
    make install-static DESTDIR="$pkgdir" PLAT=psp LUAV=5.5

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
