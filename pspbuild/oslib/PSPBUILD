pkgname=oslib
pkgver=1.5.1
pkgrel=2
pkgdesc="OldSchool Library (OSLib) is a lightweight and versatile C++ library designed to provide functionality and tools commonly used in classic game development and retro programming project"
arch=(any)
url="https://github.com/StochasticEagle/psp-oslib"
license=('GPL-2.0-only')
groups=('psp-libraries')
depends=('libxmp-lite' 'libpspmath' 'zlib' 'libpng' 'jpeg' 'giflib')
makedepends=()
optdepends=()
source=("oslib::git+https://github.com/StochasticEagle/psp-oslib.git#commit=8a574fe03fc016117e194fa6dfb3fbc116ed15fa")
psp_source_components=([0]="components/oslib")
sha256sums=('SKIP')

build() {
    cd $pkgname
    cmake --toolchain "${PSPDEV}/psp/share/pspdev.cmake" -DCMAKE_BUILD_TYPE=Release . "${XTRA_OPTS[@]}" || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd $pkgname
    make --quiet DESTDIR="${pkgdir}" ${MAKEFLAGS} install
    install -d -m 755 -p "${pkgdir}/psp"
    mv "${pkgdir}/${PSPDEV}/psp/lib" "${pkgdir}/psp/"
    mv "${pkgdir}/${PSPDEV}/psp/include" "${pkgdir}/psp/"

    install -d -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"

    cd "$pkgdir/${PSPDEV}/psp"
    while [ "${PWD}" != "${pkgdir}" ]; do
        OLDPWD="${PWD}"
        cd ..
        rmdir "${OLDPWD}"
    done
}
