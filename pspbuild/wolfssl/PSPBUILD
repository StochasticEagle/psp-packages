pkgname=wolfssl
pkgver=5.9.2
pkgrel=4
pkgdesc="The wolfSSL library is a small, fast, portable implementation of TLS/SSL for embedded devices to the cloud. wolfSSL supports up to TLS 1.3!"
arch=(any)
url="https://www.wolfssl.com/"
license=('GPL-2.0-only')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=(
    "$pkgname-$pkgver-stable::git+https://github.com/wolfSSL/wolfssl.git#commit=ac01707f552c611fbd135cc723b2682b3e7f80f2"
)
sha256sums=(
    'SKIP'
)

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd "$pkgname-$pkgver-stable"

    # PSP does not provide IPv6. Guard wolfSSL's IPv6 alternate-name helper
    # with WOLFSSL_IPV6 so disabling IPv6 also excludes these code paths.
    cat > "$srcdir/wolfssl-psp.patch" <<'PATCH'
--- a/src/internal.c
+++ b/src/internal.c
@@ -14382,7 +14382,8 @@
 #endif /* !NO_TLS */
 
 #ifndef NO_CERTS
-#if defined(WOLFSSL_IP_ALT_NAME) && !defined(WOLFSSL_USER_IO)
+#if defined(WOLFSSL_IP_ALT_NAME) && defined(WOLFSSL_IPV6) && \
+    !defined(WOLFSSL_USER_IO)
 static int MatchIPv6(const char* pattern, int patternLen,
                      const char* str, word32 strLen)
 {
@@ -14480,7 +14481,8 @@
     if (pattern == NULL || str == NULL || patternLen <= 0 || strLen == 0)
         return 0;
 
-#if defined(WOLFSSL_IP_ALT_NAME) && !defined(WOLFSSL_USER_IO)
+#if defined(WOLFSSL_IP_ALT_NAME) && defined(WOLFSSL_IPV6) && \
+    !defined(WOLFSSL_USER_IO)
     /* First try to match IPv6 addresses */
     if (MatchIPv6(pattern, patternLen, str, strLen))
         return 1;
PATCH
    psp_apply_patch "$srcdir/wolfssl-psp.patch" -Np1
    sed -i 's#@prefix@#/psp#' support/wolfssl.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' support/wolfssl.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' support/wolfssl.pc.in
    sed -i 's#@includedir@#${prefix}/include#' support/wolfssl.pc.in
}

build() {
    cd "$pkgname-$pkgver-stable"
    CFLAGS="-DNO_WRITEV" cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DWOLFSSL_CRYPT_TESTS=OFF \
        -DWOLFSSL_EXAMPLES=OFF \
        -DWOLFSSL_CURL=ON \
        -DWOLFSSL_IPV6=no \
        -DWARNING_C_FLAGS=-w \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "$pkgname-$pkgver-stable"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSING "$pkgdir/psp/share/licenses/$pkgname"
}
