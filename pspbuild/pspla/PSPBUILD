pkgname=pspla
pkgver=2.2.0
pkgrel=4
pkgdesc="A VFPU accelerated linear algebra & quaternion library for PSP"
arch=(any)
url="https://github.com/Jayanky/pspla"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("${pkgname}-${pkgver}::git+https://github.com/Jayanky/pspla.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "${pkgname}-${pkgver}"
    make
}

package() {
    cd "${pkgname}-${pkgver}"
    mkdir -m 755 -p "$pkgdir/psp/lib"
    install -m 644 libpspla2.a "$pkgdir/psp/lib"
    mkdir -m 755 -p "$pkgdir/psp/include"
    cp -R pspla2.h "$pkgdir/psp/include"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
