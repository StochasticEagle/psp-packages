pkgname=bullet3
pkgver=3.25
pkgrel=3
pkgdesc="Bullet Physics SDK: real-time collision detection and multi-physics simulation for VR, games, visual effects, robotics, machine learning etc."
arch=(any)
url="https://github.com/bulletphysics/bullet3"
license=('Zlib')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("git+https://github.com/bulletphysics/bullet3.git#commit=2c204c49e56ed15ec5fcfa71d199ab6d6570b3f5" "psp.patch")
sha256sums=("SKIP" "SKIP")

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd $pkgname
    psp_apply_patch ../psp.patch -Np1
    sed -i 's#@PREFIX@#/psp#' bullet.pc.cmake
}

build() {
    cd $pkgname 
    cmake --toolchain "${PSPDEV}/psp/share/pspdev.cmake" . -DCMAKE_POLICY_VERSION_MINIMUM=3.10 -DBUILD_EXTRAS=OFF -DBUILD_CPU_DEMOS=OFF -DBUILD_OPENGL3_DEMOS=OFF -DBUILD_BULLET2_DEMOS=OFF -DBUILD_UNIT_TESTS=OFF -DBUILD_CLSOCKET=OFF -DBUILD_BULLET3_OPENCL=OFF -DCMAKE_BUILD_TYPE=Release --install-prefix=/psp "${XTRA_OPTS[@]}" || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd $pkgname
    make --quiet ${MAKEFLAGS} DESTDIR="$pkgdir" install
    install -d -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE.txt "$pkgdir/psp/share/licenses/$pkgname"
}
