+	}
 
+	data = SDL_malloc((size_t)size);
+	if ( !data ) {
+		Mix_SetError("Out of memory");
+		goto done;
+	}
+	if ( SDL_RWread(rw, data, 1, (size_t)size) != (size_t)size ) {
+		Mix_SetError("Could not read MOD stream");
+		goto done;
+	}
+
+	module = (MODULE *)SDL_malloc(sizeof(*module));
+	if ( !module ) {
+		Mix_SetError("Out of memory");
+		goto done;
+	}
+	SDL_memset(module, 0, sizeof(*module));
+	module->context = xmp_create_context();
+	if ( !module->context ) {
+		Mix_SetError("Could not create libxmp context");
+		SDL_free(module);
+		module = NULL;
+		goto done;
+	}
+
+	result = xmp_load_module_from_memory(module->context, data, size);
+	if ( result < 0 ) {
+		Mix_SetError("libxmp failed to load module (%d)", result);
+		xmp_free_context(module->context);
+		SDL_free(module);
+		module = NULL;
+		goto done;
+	}
+	module->volume = MIX_MAX_VOLUME;
+
+done:
+	SDL_free(data);
 	if ( freerw ) {
 		SDL_RWclose(rw);
 	}
 	return module;
 }
 
