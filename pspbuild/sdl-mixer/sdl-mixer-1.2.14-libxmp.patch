-		return NULL;
+		goto done;
 	}
 
-	module = MikMod_LoadSongRW(rw,64);
-	if (!module) {
-		Mix_SetError("%s", mikmod.MikMod_strerror(*mikmod.MikMod_errno));
-		if ( freerw ) {
-			SDL_RWclose(rw);
-		}
-		return NULL;
+	start = SDL_RWtell(rw);
+	end = SDL_RWseek(rw, 0, RW_SEEK_END);
+	if ( start < 0 || end < start || SDL_RWseek(rw, start, RW_SEEK_SET) < 0 ) {
+		Mix_SetError("Could not seek MOD stream");
+		goto done;
