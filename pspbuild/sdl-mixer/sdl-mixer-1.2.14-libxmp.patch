+
+	if ( !music ) {
+		return;
+	}
+	if ( music->started ) {
+		xmp_end_player(music->context);
+		music->started = 0;
+	}
+
+	result = xmp_start_player(music->context, current_output_rate, current_xmp_format);
+	if ( result < 0 ) {
+		Mix_SetError("libxmp failed to start player (%d)", result);
+		music->ended = 1;
+		return;
+	}
+
+	music->started = 1;
+	music->ended = 0;
+	MOD_setvolume(music, volume);
 }
 
