pkgname=pixman
pkgver=0.46.4
pkgrel=6
pkgdesc="Pixman is a low-level software library for pixel manipulation"
arch=(any)
url="https://www.pixman.org/"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("pixman-${pkgver}::git+https://gitlab.freedesktop.org/pixman/pixman.git#commit=9cc163c9da0fb4da430641715313d95a6ec466d9")
sha256sums=('SKIP')

build() {
    cd "${pkgname}-${pkgver}"

    # repeat() is intentionally typed for ordinary integer pixel coordinates,
    # but pixman's scaled fast paths also call it with pixman_fixed_t vx/vy.
    # PSP typedefs pixman_fixed_t as long int, so those calls are not type
    # compatible with int *. Keep the integer helper unchanged and provide a
    # fixed-point equivalent for the fixed-coordinate call sites.
    if ! grep -q '^repeat_fixed (pixman_repeat_t repeat' pixman/pixman-inlines.h; then
        grep -q '^#if SIZEOF_LONG > 4' pixman/pixman-inlines.h || { exit 1; }
        sed -i '/^#if SIZEOF_LONG > 4/i\
static force_inline pixman_bool_t\
repeat_fixed (pixman_repeat_t repeat, pixman_fixed_t *c, pixman_fixed_t size)\
{\
    if (repeat == PIXMAN_REPEAT_NONE)\
    {\
        if (*c < 0 || *c >= size)\
            return FALSE;\
    }\
    else if (repeat == PIXMAN_REPEAT_NORMAL)\
    {\
        while (*c >= size)\
            *c -= size;\
        while (*c < 0)\
            *c += size;\
    }\
    else if (repeat == PIXMAN_REPEAT_PAD)\
    {\
        *c = CLIP (*c, 0, size - 1);\
    }\
    else\
    {\
        *c = MOD (*c, size * 2);\
        if (*c >= size)\
            *c = size * 2 - *c - 1;\
    }\
\
    return TRUE;\
}\
' pixman/pixman-inlines.h
    fi

    sed -i \
        -e 's/repeat (PIXMAN_REPEAT_NORMAL, &vx/repeat_fixed (PIXMAN_REPEAT_NORMAL, \&vx/g' \
        -e 's/repeat (PIXMAN_REPEAT_NORMAL, &vy/repeat_fixed (PIXMAN_REPEAT_NORMAL, \&vy/g' \
        pixman/pixman-inlines.h

    grep -q 'repeat_fixed (PIXMAN_REPEAT_NORMAL, &vx' pixman/pixman-inlines.h || { exit 1; }
    grep -q 'repeat_fixed (PIXMAN_REPEAT_NORMAL, &vy' pixman/pixman-inlines.h || { exit 1; }
    # Meson's built-in threads dependency injects -pthread, which psp-gcc does
    # not support. Use the PSP pthread pkg-config metadata instead; it supplies
    # -lpthread and the required PSPSDK pthreadglue library.
    sed -i "/^dep_threads = dependency('threads'/c\\dep_threads = dependency('pthread', method : 'pkg-config', required : true)" meson.build

    cat > psp-cross.ini <<EOF
[binaries]
c = '${PSPDEV}/bin/psp-gcc'
ar = '${PSPDEV}/bin/psp-ar'
ranlib = '${PSPDEV}/bin/psp-ranlib'
strip = '${PSPDEV}/bin/psp-strip'
pkg-config = 'pkg-config'

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'psp'
cpu_family = 'mips'
cpu = 'allegrex'
endian = 'little'

[built-in options]
c_args = ['-G0', '-I${PSPDEV}/psp/include', '-I${PSPDEV}/psp/sdk/include', '-DPSP', '-D__PSP__', '-D_PSP_FW_VERSION=600']
c_link_args = ['-L${PSPDEV}/lib', '-L${PSPDEV}/psp/lib', '-L${PSPDEV}/psp/sdk/lib', '-Wl,-zmax-page-size=128']
EOF

    # PSP's EABI toolchain cannot emit PIC. Meson defaults b_staticpic=true,
    # even for static-only builds, so override it explicitly. Reconfigure is
    # required here because package builds intentionally reuse build trees.
    meson setup --reconfigure build \
        --cross-file psp-cross.ini \
        --prefix=/psp \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Db_staticpic=false \
        -Dtests=disabled \
        -Ddemos=disabled \
        -Dgtk=disabled \
        -Dlibpng=disabled \
        -Dopenmp=disabled \
        -Dtls=disabled \
        -Dloongson-mmi=disabled \
        -Dmmx=disabled \
        -Dsse2=disabled \
        -Dssse3=disabled \
        -Dvmx=disabled \
        -Darm-simd=disabled \
        -Dneon=disabled \
        -Da64-neon=disabled \
        -Dmips-dspr2=disabled \
        -Drvv=disabled \
        -Dgnu-inline-asm=disabled || { exit 1; }

    meson compile -C build || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"

    DESTDIR="$pkgdir" meson install -C build --no-rebuild || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}
