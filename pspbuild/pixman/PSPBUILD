pkgname=pixman
pkgver=0.46.4
pkgrel=10
pkgdesc="Pixman is a low-level software library for pixel manipulation"
arch=(any)
url="https://www.pixman.org/"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("pixman-${pkgver}::git+https://gitlab.freedesktop.org/pixman/pixman.git#commit=9cc163c9da0fb4da430641715313d95a6ec466d9")
sha256sums=('SKIP')

build() {
    cd "${pkgname}-${pkgver}"

    # Normalize the pinned upstream source to the PSP-compatible form.
    # These transforms are deliberately state-aware: an already-fixed source
    # is accepted, an unfixed source is updated, and only an unrecognized
    # upstream layout is treated as an incompatibility.
    pixman_inlines=pixman/pixman-inlines.h
    pixman_glyph=pixman/pixman-glyph.c

    if ! grep -Eq '^[[:space:]]*repeat_fixed[[:space:]]*\(' "$pixman_inlines"; then
        if ! grep -Eq '^[[:space:]]*#if[[:space:]]+BILINEAR_INTERPOLATION_BITS[[:space:]]*<=[[:space:]]*4' "$pixman_inlines"; then
            echo "ERROR: pixman repeat_fixed insertion anchor changed upstream." >&2
            exit 1
        fi
        sed -i '/^[[:space:]]*#if[[:space:]]\+BILINEAR_INTERPOLATION_BITS[[:space:]]*<=[[:space:]]*4/i\
static force_inline pixman_bool_t\
repeat_fixed (pixman_repeat_t repeat, pixman_fixed_t *c, pixman_fixed_t size)\
{\
    if (repeat == PIXMAN_REPEAT_NONE)\
    {\
        if (*c < 0 || *c >= size)\
            return FALSE;\
    }\
    else if (repeat == PIXMAN_REPEAT_NORMAL)\
    {\
        while (*c >= size)\
            *c -= size;\
        while (*c < 0)\
            *c += size;\
    }\
    else if (repeat == PIXMAN_REPEAT_PAD)\
    {\
        *c = CLIP (*c, 0, size - 1);\
    }\
    else\
    {\
        *c = MOD (*c, size * 2);\
        if (*c >= size)\
            *c = size * 2 - *c - 1;\
    }\
\
    return TRUE;\
}\
' "$pixman_inlines"
        echo "Applied PSP fixed-point repeat helper."
    fi

    sed -E -i \
        -e 's/repeat[[:space:]]*\([[:space:]]*PIXMAN_REPEAT_NORMAL,[[:space:]]*&vx/repeat_fixed (PIXMAN_REPEAT_NORMAL, \&vx/g' \
        -e 's/repeat[[:space:]]*\([[:space:]]*PIXMAN_REPEAT_NORMAL,[[:space:]]*&vy/repeat_fixed (PIXMAN_REPEAT_NORMAL, \&vy/g' \
        "$pixman_inlines"

    if ! grep -Eq 'repeat_fixed[[:space:]]*\([[:space:]]*PIXMAN_REPEAT_NORMAL,[[:space:]]*&vx' "$pixman_inlines" ||
       ! grep -Eq 'repeat_fixed[[:space:]]*\([[:space:]]*PIXMAN_REPEAT_NORMAL,[[:space:]]*&vy' "$pixman_inlines"; then
        echo "ERROR: pixman fixed-point repeat call sites changed upstream." >&2
        exit 1
    fi

    # PSP typedefs int32_t as long int. Normalize the PAD helper's temporary
    # widths to the same type as its pointer outputs.
    sed -E -i \
        -e 's/^([[:space:]]*)int([[:space:]]+)width1([[:space:]]*=)/\1int32_t\2width1\3/' \
        -e 's/^([[:space:]]*)int([[:space:]]+)width2([[:space:]]*=)/\1int32_t\2width2\3/' \
        "$pixman_inlines"

    if ! grep -Eq '^[[:space:]]*int32_t[[:space:]]+width1[[:space:]]*=' "$pixman_inlines" ||
       ! grep -Eq '^[[:space:]]*int32_t[[:space:]]+width2[[:space:]]*=' "$pixman_inlines"; then
        echo "ERROR: pixman PAD width declarations changed upstream." >&2
        exit 1
    fi

    # force_align_arg_pointer is an i386-only stack-alignment workaround.
    # If upstream still carries the broad GCC guard, narrow it to i386.
    if grep -q 'force_align_arg_pointer' "$pixman_glyph"; then
        sed -E -i \
            's/#if[[:space:]]+defined\(__GNUC__\)[[:space:]]*&&[[:space:]]*!defined\(__x86_64__\)[[:space:]]*&&[[:space:]]*!defined\(__amd64__\)/#if defined(__GNUC__) \&\& defined(__i386__)/' \
            "$pixman_glyph"
        if ! grep -q '#if defined(__GNUC__) && defined(__i386__)' "$pixman_glyph"; then
            echo "ERROR: pixman force_align_arg_pointer guard changed upstream." >&2
            exit 1
        fi
    fi

    # Meson's built-in threads dependency injects -pthread, unsupported by
    # psp-gcc. Prefer the PSP pthread pkg-config metadata. Accept an already
    # normalized source and update the stock dependency when present.
    if ! grep -Eq "dependency\('pthread',[[:space:]]*method[[:space:]]*:[[:space:]]*'pkg-config'" meson.build; then
        if grep -Eq "^dep_threads[[:space:]]*=[[:space:]]*dependency\('threads'" meson.build; then
            sed -E -i \
                "s|^dep_threads[[:space:]]*=[[:space:]]*dependency\('threads'[^)]*\)|dep_threads = dependency('pthread', method : 'pkg-config', required : true)|" \
                meson.build
            echo "Switched pixman thread detection to PSP pthread pkg-config metadata."
        else
            echo "ERROR: pixman thread dependency declaration changed upstream." >&2
            exit 1
        fi
    fi

    cat > psp-cross.ini <<EOF
[binaries]
c = '${PSPDEV}/bin/psp-gcc'
ar = '${PSPDEV}/bin/psp-ar'
ranlib = '${PSPDEV}/bin/psp-ranlib'
strip = '${PSPDEV}/bin/psp-strip'
pkg-config = 'pkg-config'

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'psp'
cpu_family = 'mips'
cpu = 'allegrex'
endian = 'little'

[built-in options]
c_args = ['-G0', '-I${PSPDEV}/psp/include', '-I${PSPDEV}/psp/sdk/include', '-DPSP', '-D__PSP__', '-D_PSP_FW_VERSION=600']
c_link_args = ['-L${PSPDEV}/lib', '-L${PSPDEV}/psp/lib', '-L${PSPDEV}/psp/sdk/lib', '-Wl,-zmax-page-size=128']
EOF

    # PSP's EABI toolchain cannot emit PIC. Meson defaults b_staticpic=true,
    # even for static-only builds, so override it explicitly. Reconfigure only
    # when this is an existing Meson build tree; a fresh invalidated package
    # build must use normal setup.
    meson_setup_mode=()
    if [[ -f build/meson-private/coredata.dat ]]; then
        meson_setup_mode=(--reconfigure)
    fi

    meson setup "${meson_setup_mode[@]}" build \
        --cross-file psp-cross.ini \
        --prefix=/psp \
        --libdir=lib \
        --buildtype=release \
        --default-library=static \
        -Db_staticpic=false \
        -Dtests=disabled \
        -Ddemos=disabled \
        -Dgtk=disabled \
        -Dlibpng=disabled \
        -Dopenmp=disabled \
        -Dtls=disabled \
        -Dloongson-mmi=disabled \
        -Dmmx=disabled \
        -Dsse2=disabled \
        -Dssse3=disabled \
        -Dvmx=disabled \
        -Darm-simd=disabled \
        -Dneon=disabled \
        -Da64-neon=disabled \
        -Dmips-dspr2=disabled \
        -Drvv=disabled \
        -Dgnu-inline-asm=disabled || { exit 1; }

    meson compile -C build || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"

    DESTDIR="$pkgdir" meson install -C build --no-rebuild || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}
