pkgname=leptonica
pkgver=1.87.0
pkgrel=3
pkgdesc="An open source C library for efficient image processing and image analysis operations"
arch=(any)
url="https://www.leptonica.org/"
license=('BSD-2-Clause')
depends=('zlib' 'libpng' 'jpeg')
groups=('psp-libraries')
makedepends=()
optdepends=()
source=(
    "$pkgname-${pkgver}::git+https://github.com/DanBloomberg/leptonica.git#commit=13275a278eb55b5746e33f95fbf5a2c8f604b3ab"
    "${pkgname}-${pkgver}-PSP.patch"
)
sha256sums=(
    "SKIP"
    "SKIP"
)

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd "$pkgname-${pkgver}"

    psp_apply_patch "../${pkgname}-${pkgver}-PSP.patch" -p1

    sed -i 's#@prefix@#/psp#' lept.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' lept.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' lept.pc.in
    sed -i 's#@includedir@#${prefix}/include#' lept.pc.in
}

build() {
    cd "$pkgname-${pkgver}"

    ./autogen.sh --host=psp
    ./configure --without-giflib --without-libtiff --without-libwebp --without-libwebpmux --without-libopenjpeg \
    --disable-programs --host=psp --prefix=/psp

    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$pkgname-${pkgver}"
    make --quiet DESTDIR="$pkgdir" $MAKEFLAGS install
    sed -i "s#${PSPDEV}##g" "$pkgdir/psp/lib/pkgconfig/lept.pc"

    rm "${pkgdir}/psp/lib/libleptonica.la"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 leptonica-license.txt "$pkgdir/psp/share/licenses/$pkgname"
}
