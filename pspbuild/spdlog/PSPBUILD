pkgname=spdlog
pkgver=1.17.0
pkgrel=4
pkgdesc="Very fast, header only, C++ logging library"
arch=(any)
url="https://github.com/gabime/spdlog"
license=(MIT)
groups=('psp-libraries')
depends=(fmt)
makedepends=()
provides=()
conflicts=()
source=("$pkgname-$pkgver::git+https://github.com/gabime/spdlog.git#commit=79524ddd08a4ec981b7fea76afd08ee05f83755d"
        "spdlog-psp.patch")
sha256sums=('SKIP'
            '19c3ca85f22d845e96a6b97e653ef17426ab55dd2d73fabbd3396a597689cacb')

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
  cd "$pkgname-$pkgver"
  psp_apply_patch ../spdlog-psp.patch -p1

  # patch spdlog.pc.in
  sed -i 's/@CMAKE_INSTALL_PREFIX@/\/psp/' ./cmake/spdlog.pc.in
}

build() {
  cmake -B build -S "$pkgname-$pkgver" -Wno-dev \
    -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/psp \
    -DSPDLOG_BUILD_BENCH=OFF \
    -DSPDLOG_BUILD_EXAMPLE=OFF \
    -DSPDLOG_BUILD_TESTS=OFF \
    -DSPDLOG_BUILD_SHARED=OFF \
    -DSPDLOG_FMT_EXTERNAL=ON \
    -DSPDLOG_NO_THREAD_ID=ON \
    -DSPDLOG_NO_ATOMIC_LEVELS=ON \
    -DSPDLOG_NO_EXCEPTIONS=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 $pkgname-$pkgver/LICENSE -t "$pkgdir/psp/share/licenses/$pkgname/"
}
