pkgname=box2d
pkgver=3.1.1
pkgrel=3
pkgdesc="Box2D is a 2D physics engine for games"
arch=(any)
url="https://github.com/erincatto/box2d"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
provides=()
conflicts=()
source=("box2d-${pkgver}::git+https://github.com/erincatto/box2d.git#commit=8c661469c9507d3ad6fbd2fea3f1aa71669c2fe3")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -B build -S . -Wno-dev \
    -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/psp \
    -DBOX2D_BUILD_DOCS=OFF \
    -DGLFW_BUILD_WAYLAND=OFF \
    -DBOX2D_SAMPLES=OFF \
    -DBOX2D_BENCHMARKS=OFF \
    -DBOX2D_PROFILE=OFF \
    -DBOX2D_VALIDATE=OFF \
    -DBOX2D_UNIT_TESTS=OFF
  cmake --build build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir/psp/share/licenses/$pkgname/"
}
