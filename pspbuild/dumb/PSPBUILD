pkgname=dumb
pkgver=2.0.3
pkgrel=7
pkgdesc="Dynamic Universal Music Bibliotheque - DUMB - Module/tracker based music format parser and player library"
arch=(any)
url="https://github.com/kode54/dumb"
license=('custom')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("$pkgname-${pkgver}::git+https://github.com/kode54/dumb.git#commit=396caa4d31859045ccb5ef943fd430ca4026cce8")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-${pkgver}"
    sed -i 's#@CMAKE_INSTALL_PREFIX@#/psp#' pkg-config.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_LIBDIR@#${prefix}/lib#' pkg-config.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_INCLUDEDIR@#${prefix}/include#' pkg-config.pc.in
}

build() {
    cd "$pkgname-${pkgver}"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX="${pkgdir}/psp" \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_ALLEGRO4=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DCMAKE_C_FLAGS="-G0 -DDUMB_OFF_T_CUSTOM=\"long long\"" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "$pkgname-${pkgver}"
    cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
