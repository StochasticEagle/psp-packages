pkgname=sdl3-ttf
pkgver=3.2.2
pkgrel=6
pkgdesc="A companion library to SDL3 for working with TrueType (tm) fonts"
arch=(any)
url="https://wiki.libsdl.org/SDL3_ttf/FrontPage"
license=('Zlib')
groups=('psp-libraries')
depends=('sdl3' 'harfbuzz')
makedepends=()
optdepends=()
source=(
    "SDL3_ttf-${pkgver}::git+https://github.com/libsdl-org/SDL_ttf.git#commit=a1ce3670aec736ecbf0936c43f2f0cc53aa61e5b"
)
sha256sums=(
    "SKIP"
)

prepare() {
    cd "${srcdir}/SDL3_ttf-${pkgver}"
    sed -i '/^prefix=/s/=.*$/=\/psp/' cmake/sdl3-ttf.pc.in
}

build() {
    cd "${srcdir}/SDL3_ttf-${pkgver}"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DSDLTTF_VENDORED=OFF \
        -DSDLTTF_STRICT=ON \
        -DSDLTTF_SAMPLES=OFF \
        -DSDLTTF_PLUTOSVG=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "${srcdir}/SDL3_ttf-${pkgver}"
    DESTDIR="${pkgdir}" cmake --install build || { exit 1; }

    mv "${pkgdir}/psp/share/licenses/SDL3_ttf" "${pkgdir}/psp/share/licenses/${pkgname}"
}
