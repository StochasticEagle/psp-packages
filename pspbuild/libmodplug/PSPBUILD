pkgname=libmodplug
pkgver=0.8.9.0
pkgrel=3
pkgdesc="libmodplug - the library which was part of the Modplug-xmms project"
arch=(any)
url="https://github.com/Konstanty/libmodplug"
license=('custom:Public-Domain')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
provides=()
source=("git+https://github.com/Konstanty/libmodplug#commit=d7ba5efd5816696fba668a23194940f796d62b95")
sha256sums=("SKIP")

prepare() {
    cd libmodplug
    sed -i 's#@prefix@#/psp#' libmodplug.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' libmodplug.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' libmodplug.pc.in
    sed -i '/configure_file/{s/)/ @ONLY)/;}' CMakeLists.txt
}

build() {
    cd libmodplug
    cmake -S . -B pspbuild \
        -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release
    cmake --build pspbuild --parallel
}

package() {
    cd libmodplug
    DESTDIR="$pkgdir" cmake --install pspbuild
    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}

