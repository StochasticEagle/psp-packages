pkgname=libxmp-lite
pkgver=4.6.3
pkgrel=3
pkgdesc="Libxmp is a library that renders module files to PCM data"
arch=(any)
url="https://github.com/libxmp/libxmp"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=()
sha256sums=()

prepare() {
    rm -rf "$srcdir/$pkgname-$pkgver"
    cp -a "$startdir/../components/libxmp" "$srcdir/$pkgname-$pkgver"
    rm -rf "$srcdir/$pkgname-$pkgver/.git"
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    mkdir -p build && cd build
    cmake -Wno-dev -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" -DCMAKE_INSTALL_PREFIX=/psp -DBUILD_SHARED=OFF -DBUILD_LITE=ON \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 "${XTRA_OPTS[@]}" .. || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$srcdir/$pkgname-$pkgver/build"
    make --quiet $MAKEFLAGS DESTDIR="${pkgdir}/" install || { exit 1; }

    mkdir -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 ../README "${pkgdir}/psp/share/licenses/${pkgname}"
}
