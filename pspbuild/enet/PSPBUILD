pkgname=enet
pkgver=1.3.18
pkgrel=6
pkgdesc="ENet reliable UDP networking library"
arch=(any)
url="http://enet.bespin.org/"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("$pkgname-$pkgver::git+https://github.com/lsalzman/enet.git#commit=5a9c537fd464b3c6d3c55e1d3bd47588faf71b42")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    # if ARCHIVE DESTINATION is not specified, static library will be installed to LIBRARY DESTINATION
    sed -i '/ARCHIVE DESTINATION/d' CMakeLists.txt
}

build() {
    cd "$pkgname-$pkgver"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
