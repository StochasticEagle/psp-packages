pkgname=libconfuse
pkgver=3.3
pkgrel=7
pkgdesc="Small configuration file parser library for C"
arch=(any)
url="https://github.com/libconfuse/libconfuse/"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("${pkgname}-${pkgver}::git+https://github.com/libconfuse/libconfuse.git#commit=040efe8ece8c9ba5528096db281025ea715ab098")
sha256sums=('SKIP')

prepare() {
    cd "${pkgname}-${pkgver}"
    sed -i 's#@prefix@#/psp#' libconfuse.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' libconfuse.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' libconfuse.pc.in
    sed -i 's#@includedir@#${prefix}/include#' libconfuse.pc.in
}

build() {
    cd "${pkgname}-${pkgver}"
    ./autogen.sh
        CFLAGS="-G0 -O2 -DPSP" LDFLAGS="-L$(psp-config --pspsdk-path)/lib" ./configure --host psp --prefix=/psp --disable-examples || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    make --quiet $MAKEFLAGS DESTDIR="$pkgdir/" install || { exit 1; }
    sed -i "s#${PSPDEV}##g" "$pkgdir/psp/lib/libconfuse.la"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
