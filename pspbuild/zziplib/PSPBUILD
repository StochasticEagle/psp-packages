pkgname=zziplib
pkgver=0.13.81
pkgrel=2
pkgdesc="Provides read access to zipped files in a zip-archive"
arch=(any)
url="http://zziplib.sourceforge.net/"
license=('Zlib')
groups=('psp-libraries')
depends=('zlib')
makedepends=()
optdepends=()
source=("$pkgname-$pkgver::git+https://github.com/gdraheim/zziplib.git#commit=cb6e89d075bd98a3f42664753e5d01c8fd0539f4")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF \
        -DZZIPSDL=OFF \
        -DZZIPBINS=OFF \
        -DZZIPTEST=OFF \
        -DZZIPDOCS=OFF \
        -DGCOV_PATH=psp-gcov \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING.LIB "$pkgdir/psp/share/licenses/$pkgname"
}
