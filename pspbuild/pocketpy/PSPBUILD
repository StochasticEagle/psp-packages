pkgname=pocketpy
pkgver=2.2.0
pkgrel=1
pkgdesc="Python interpreter for game scripting"
arch=(any)
license=('MIT')
groups=('psp-libraries')
url="https://pocketpy.dev/"
makedepends=()
source=("$pkgname-${pkgver}::git+https://github.com/pocketpy/pocketpy.git#commit=6baa5c7f522b8598c2496e5d91bdfc9fc4c12532")
sha256sums=('SKIP')

build() {
    cd "$pkgname-${pkgver}"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DPK_ENABLE_THREADS=OFF \
        -DPK_BUILD_WITH_UNITY=OFF \
        -DPK_BUILD_STATIC_MAIN=ON \
        -DPK_BUILD_STATIC_LIB=ON \
        -DPK_BUILD_SHARED_LIB=OFF \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "$pkgname-${pkgver}/build"

    mkdir -m 755 -p "$pkgdir/psp/lib" "$pkgdir/psp/include" "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 libpocketpy.a "$pkgdir/psp/lib"
    cp -a ../include/. "$pkgdir/psp/include/"
    install -m 644 ../LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
