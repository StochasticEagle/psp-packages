pkgname=cereal
pkgver=1.3.2
pkgrel=3
pkgdesc="A C++11 library for serialization"
arch=(any)
url="https://github.com/USCiLab/cereal"
license=('BSD-3-Clause')
groups=('psp-libraries')
depends=()
makedepends=()
provides=()
conflicts=()
source=("cereal-$pkgver::git+https://github.com/USCiLab/cereal.git#commit=ebef1e929807629befafbb2918ea1a08c7194554")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname-$pkgver" -Wno-author \
    -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/psp \
    -DSKIP_PERFORMANCE_COMPARISON=ON \
    -DBUILD_DOC=OFF \
    -DBUILD_SANDBOX=OFF \
    -DBUILD_TESTS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 $pkgname-$pkgver/LICENSE -t "$pkgdir/psp/share/licenses/$pkgname/"
}