pkgname=sail
pkgver=1.2.0
pkgrel=10
pkgdesc="SAIL cross-platform image decoding library"
arch=(any)
url='https://github.com/HappySeaFox/sail'
license=('MIT')
groups=('psp-libraries')
depends=('jpeg' 'libpng' 'giflib')
makedepends=()
optdepends=()
provides=()
source=(
    "sail::git+https://github.com/HappySeaFox/sail.git#commit=28426b7799d4346aa500a2d0a4236ebd3e3d011a"
    "psp.patch"
)
sha256sums=('SKIP' 'SKIP')

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd "$srcdir/$pkgname"
    psp_apply_patch "$srcdir/psp.patch" -Np1
    sed -i 's#@CMAKE_INSTALL_PREFIX@#/psp#' src/*/pkgconfig/*.pc.in src/bindings/sail-c++/pkgconfig/sail-c++.pc.in
}

build() {
    cd "$srcdir/$pkgname"
    cmake --toolchain "${PSPDEV}/psp/share/pspdev.cmake" -DBUILD_SHARED_LIBS=OFF "${XTRA_OPTS[@]}" -DBUILD_TESTING=OFF -DSAIL_BUILD_EXAMPLES=OFF -DSAIL_BUILD_APPS=OFF \
        -DSAIL_THIRD_PARTY_CODECS_PATH=OFF -DCMAKE_BUILD_TYPE=Release --install-prefix=/psp || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$srcdir/$pkgname"
    make --quiet $MAKEFLAGS DESTDIR="$pkgdir" install
    find "$pkgdir/psp/lib/cmake" -type f -name '*.cmake' -exec sed -i "s#${PSPDEV}##g" {} +

    install -d -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 LICENSE.txt "${pkgdir}/psp/share/licenses/${pkgname}"
}
