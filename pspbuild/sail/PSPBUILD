pkgname=sail
pkgver=1.2.0
pkgrel=4
pkgdesc="SAIL cross-platform image decoding library"
arch=(any)
url='https://github.com/HappySeaFox/sail'
license=('MIT')
groups=('psp-libraries')
depends=('jpeg' 'libpng' 'giflib')
makedepends=()
optdepends=()
provides=()
source=(
    "sail::git+https://github.com/HappySeaFox/sail.git#commit=28426b7799d4346aa500a2d0a4236ebd3e3d011a"
    "psp.patch"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
    cd "$srcdir/$pkgname"
    patch --batch --forward -Np1 -i "$srcdir/psp.patch"
    sed -i 's#@CMAKE_INSTALL_PREFIX@#${PSPDEV}/psp#' src/*/pkgconfig/*.pc.in src/bindings/sail-c++/pkgconfig/sail-c++.pc.in
}

build() {
    cd "$srcdir/$pkgname"
    psp-cmake -DBUILD_SHARED_LIBS=OFF "${XTRA_OPTS[@]}" -DBUILD_TESTING=OFF -DSAIL_BUILD_EXAMPLES=OFF -DSAIL_BUILD_APPS=OFF \
        -DSAIL_THIRD_PARTY_CODECS_PATH=OFF -DCMAKE_BUILD_TYPE=Release --install-prefix="${pkgdir}/psp" || { exit 1; }
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$srcdir/$pkgname"
    make --quiet $MAKEFLAGS install

    install -d -m 755 -p "${pkgdir}/psp/share/licenses/${pkgname}"
    install -m 644 LICENSE.txt "${pkgdir}/psp/share/licenses/${pkgname}"
}
