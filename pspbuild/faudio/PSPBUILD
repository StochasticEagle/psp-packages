pkgname=faudio
pkgver=26.06
pkgrel=4
pkgdesc="Accuracy-focused XAudio reimplementation for open platforms."
arch=(any)
license=('BSD')
groups=('psp-libraries')
url="https://fna-xna.github.io/"
depends=('sdl2')
optdepends=()
makedepends=()
source=("FAudio-${pkgver}::git+https://github.com/FNA-XNA/FAudio.git#commit=667942a9097991f5cb6d1532a7ac3142e0581102")
sha256sums=('SKIP')

prepare() {
    cd "FAudio-${pkgver}"
    sed -i 's#@CMAKE_INSTALL_PREFIX@#/psp#g' cmake/FAudio.pc.in
    sed -i 's#@FAUDIO_PKGCONF_LIBDIR@#/psp/lib#g' cmake/FAudio.pc.in
    sed -i 's#@FAUDIO_PKGCONF_INCLUDEDIR@#/psp/include#g' cmake/FAudio.pc.in

    # PSP newlib defines int32_t as long int, while SDL2's SDL_WaitThread()
    # takes int *. Preserve FAudio's public int32_t API without an incompatible
    # pointer conversion by using an SDL-compatible temporary status.
    if grep -q 'SDL_WaitThread((SDL_Thread\*) thread, retval);' src/FAudio_platform_sdl2.c; then
        python3 - <<'PY'
from pathlib import Path
path = Path("src/FAudio_platform_sdl2.c")
text = path.read_text()
old = """void FAudio_PlatformWaitThread(FAudioThread thread, int32_t *retval)
{
\tSDL_WaitThread((SDL_Thread*) thread, retval);
}
"""
new = """void FAudio_PlatformWaitThread(FAudioThread thread, int32_t *retval)
{
\tint status;
\tSDL_WaitThread((SDL_Thread*) thread, retval != NULL ? &status : NULL);
\tif (retval != NULL)
\t\t*retval = (int32_t) status;
}
"""
if old not in text:
    raise SystemExit("ERROR: FAudio SDL2 wait-thread implementation changed upstream.")
path.write_text(text.replace(old, new, 1))
PY
    elif ! grep -q 'SDL_WaitThread((SDL_Thread\*) thread, retval != NULL ? &status : NULL);' src/FAudio_platform_sdl2.c; then
        echo "ERROR: FAudio SDL2 wait-thread implementation changed upstream." >&2
        exit 1
    fi
}

build() {
  cd "FAudio-${pkgver}"
  cmake -S . -B build \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SDL3=OFF \
        "${XTRA_OPTS[@]}" || { exit 1; }
  cmake --build build --parallel || { exit 1; }
}

package () {
  cd "FAudio-${pkgver}"
  DESTDIR="$pkgdir" cmake --install build || { exit 1; }

  mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
  install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
