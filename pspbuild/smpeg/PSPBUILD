pkgname=smpeg
pkgver=0.4.5
pkgrel=9
pkgdesc="A free MPEG1 video player library with sound support"
arch=(any)
url="https://github.com/fungos/smpeg-psp/"
license=('LGPL-2.0-only')
groups=('psp-libraries')
depends=('sdl')
makedepends=()
optdepends=()
source=(
    "git+https://github.com/fungos/smpeg-psp.git#commit=bee77b1c97b9ce437f1c4a5ba644244ab2a2c433"
    "${pkgname}-psp.patch"
)
sha256sums=(
    'SKIP'
    'SKIP'
)

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd smpeg-psp
    psp_apply_patch "../${pkgname}-psp.patch" -p1
}

build() {
    cd smpeg-psp
    make
}

package() {
    cd smpeg-psp
    mkdir -m 755 -p "$pkgdir/psp/lib" "$pkgdir/psp/include"
    cp -v libsmpeg.a "$pkgdir/psp/lib/"
    cp -v *.h "$pkgdir/psp/include/"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}

