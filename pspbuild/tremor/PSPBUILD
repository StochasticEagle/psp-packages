pkgname=tremor
pkgver=1.2.1git20250403
pkgrel=4
pkgdesc="Integer-only, fully Ogg Vorbis compliant software decoder library"
arch=(any)
url="https://wiki.xiph.org/Tremor"
license=('BSD-3-Clause')
groups=('psp-libraries')
depends=('libogg')
makedepends=()
optdepends=()
source=(
    "git+https://gitlab.xiph.org/xiph/tremor.git#commit=820fb3237ea81af44c9cc468c8b4e20128e3e5ad"
)
sha256sums=('SKIP')

prepare() {
    cd "${pkgname}"

    # VFLOAT_MULTI() and VFLOAT_ADD() write through ogg_int32_t pointers.
    # Upstream still declares these temporaries as int, which is not
    # pointer-compatible with ogg_int32_t on the PSP toolchain.
    sed -i -E 's/^([[:space:]]*)int point=0;/\1ogg_int32_t point=0;/' sharedbook.c
    sed -i -E 's/^([[:space:]]*)int val=VFLOAT_MULTI/\1ogg_int32_t val=VFLOAT_MULTI/' sharedbook.c

    local point_count val_count
    point_count=$(grep -Ec '^[[:space:]]*ogg_int32_t point=0;' sharedbook.c)
    val_count=$(grep -Ec '^[[:space:]]*ogg_int32_t val=VFLOAT_MULTI' sharedbook.c)
    if [[ "${point_count}" -ne 2 || "${val_count}" -ne 2 ]]; then
        echo "ERROR: Tremor fixed-width declarations were not applied exactly twice." >&2
        return 1
    fi
    if grep -Eq '^[[:space:]]*int point=0;|^[[:space:]]*int val=VFLOAT_MULTI' sharedbook.c; then
        echo "ERROR: Tremor still contains incompatible int declarations in sharedbook.c." >&2
        return 1
    fi

    sed -i 's#@prefix@#/psp#' vorbisidec.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' vorbisidec.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' vorbisidec.pc.in
    sed -i 's#@includedir@#${prefix}/include#' vorbisidec.pc.in
}

build() {
    cd "${pkgname}"

    # Current upstream autogen.sh only regenerates the autotools files; it no
    # longer runs configure itself.
    ./autogen.sh

    # Keep PSP/Allegrex policy in the package recipe rather than patching
    # upstream configure.ac. Tremor's configure script appends caller CFLAGS to
    # its normal GCC flags, and --enable-low-accuracy supplies _LOW_ACCURACY_.
    LDFLAGS="-L$(psp-config --pspsdk-path)/lib" \
    LIBS="-lc -lpspuser" \
    CFLAGS="-G0 -DLITTLE_ENDIAN=1 -DBYTE_ORDER=LITTLE_ENDIAN" \
    ./configure --host=psp --prefix=/psp --enable-low-accuracy

    make
}

package() {
    cd "${pkgname}"
    make DESTDIR="$pkgdir/" install

    rm "${pkgdir}/psp/lib/libvorbisidec.la"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}
