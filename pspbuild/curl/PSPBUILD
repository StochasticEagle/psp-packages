pkgname=curl
pkgver=8.22.0
pkgrel=2
pkgdesc="A library for transferring data with URL syntax"
arch=(any)
url="https://curl.se/"
license=('custom')
groups=('psp-libraries')
depends=('zlib' 'mbedtls')
optdepends=()
makedepends=()
source=("curl-${pkgver}::git+https://github.com/curl/curl.git#commit=01346829096c61b372692f6dc43ffa778c6caccd")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cmake -Wno-dev \
        -S . \
        -B build \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCURL_USE_MBEDTLS=ON \
        -DCURL_USE_LIBPSL=OFF \
        -DUSE_UNIX_SOCKETS=OFF \
        -DENABLE_IPV6=OFF \
        -DENABLE_THREADED_RESOLVER=OFF \
        -DBUILD_CURL_EXE=OFF \
        -DBUILD_SHARED_LIBS=OFF \
        -DBUILD_TESTING=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
}
