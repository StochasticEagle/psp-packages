pkgname=sdl
pkgver=1.2.15
pkgrel=12
pkgdesc="A library designed to provide low level access to audio, input, and graphics hardware"
arch=(any)
url="https://www.libsdl.org/download-1.2.php"
license=('LGPL-2.1-only')
groups=('psp-libraries')
depends=('pspirkeyb')
makedepends=()
optdepends=()
source=(
    "git+https://github.com/pspdev/SDL.git#commit=42ee00502244fc60e76ae395fcee29d82f64c369"
    "psp-iconv.patch"
)
sha256sums=('SKIP' 'SKIP')

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd "SDL"
    psp_apply_patch "$srcdir/psp-iconv.patch" -Np1
    sed -i 's#@prefix@#${PSPDEV}/psp#' sdl-config.in
    sed -i 's#@prefix@#/psp#' sdl.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' sdl-config.in sdl.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' sdl-config.in sdl.pc.in
    sed -i 's#@includedir@#${prefix}/include#' sdl-config.in sdl.pc.in
}

build() {
    cd "SDL"
    ./autogen.sh
    LDFLAGS="$LDFLAGS -L$(psp-config --pspsdk-path)/lib -L$(psp-config --psp-prefix)/lib -lc -lpspuser" \
    LIBS="$LIBS -lc -lpspuser" \
    ./configure --host=psp --prefix=/psp --enable-pspirkeyb
    make
}

package() {
    cd "SDL"
    make DESTDIR="$pkgdir/" install

    rm "${pkgdir}/psp/lib/libSDL.la"
    rm "${pkgdir}/psp/lib/libSDLmain.la"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}

