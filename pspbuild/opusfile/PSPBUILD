pkgname=opusfile
pkgver=0.12
pkgrel=4
pkgdesc="The opusfile library provides seeking, decode, and playback of Opus streams in the Ogg container."
arch=(any)
url="https://opus-codec.org/"
license=('BSD-3-Clause')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("${pkgname}-${pkgver}::git+https://github.com/xiph/opusfile.git#commit=6dfd29e7adb87f2e193575fc3fa88cbf1a0b27df")
sha256sums=('SKIP')
depends=('libogg' 'opus')

prepare() {
    cd "${pkgname}-${pkgver}"
    ./autogen.sh
}

build() {
    cd "${pkgname}-${pkgver}"
    ./configure --host=psp --prefix=/psp --disable-doc --disable-examples --disable-http --disable-shared --enable-static --enable-fixed-point
    make --quiet $MAKEFLAGS || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    make --quiet $MAKEFLAGS DESTDIR="$pkgdir" install

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}
