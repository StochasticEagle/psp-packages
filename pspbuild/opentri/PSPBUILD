pkgname=opentri
pkgver=r7.95b040d
pkgrel=9
pkgdesc="openTRI is a game engine for the PSP"
arch=(any)
url="https://github.com/fjtrujy/openTRI"
license=('GPL-2.0-only')
groups=('psp-libraries')
depends=('zlib' 'freetype2')
makedepends=()
optdepends=()
source=("git+https://github.com/fjtrujy/openTRI.git#commit=660f0c86f97c80fdf085e6e083d35a53828467cc")
sha256sums=('SKIP')

build() {
    cd openTRI
    PNG=1 FT=1 make
}

package() {
    cd openTRI

    # Upstream's install target always regenerates API documentation with
    # host doxygen. Package the already-built library and public headers
    # directly so installing openTRI does not require documentation tooling.
    install -Dm644 libtri.a "$pkgdir/psp/lib/libtri.a"

    mkdir -p "$pkgdir/psp/include/openTri"
    install -m644 ./*.h "$pkgdir/psp/include/openTri/"

    mkdir -p "$pkgdir/psp/include/streams"
    install -m644 streams/*.h "$pkgdir/psp/include/streams/"
    install -m644 streams/*.inc "$pkgdir/psp/include/streams/"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
