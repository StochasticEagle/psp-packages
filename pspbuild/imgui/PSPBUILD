pkgname=imgui
pkgver="1.92.5"
pkgrel=3
pkgdesc="Dear ImGui: Bloat-free Graphical User interface for C++ with minimal dependencies (docking branch)"
arch=(any)
url="https://github.com/adriensalon/imgui_psp"
license=("MIT")
groups=("psp-libraries")
depends=()
makedepends=()
optdepends=()
source=("$pkgname::git+https://github.com/adriensalon/imgui_psp.git#commit=c4c7480864af95331b08762825f4d82690e154ff")
sha256sums=("SKIP")

prepare() {
    cd "$srcdir/$pkgname"
    sed -i 's/@CMAKE_INSTALL_PREFIX@/\/psp/' imgui.pc.in
}

build() {
    cd "$pkgname"
    cmake -S . -B build \
        -DCMAKE_TOOLCHAIN_FILE="${PSPDEV}/psp/share/pspdev.cmake" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/psp \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }
}
