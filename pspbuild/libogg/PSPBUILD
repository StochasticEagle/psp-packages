pkgname=libogg
pkgver=1.3.6
pkgrel=4
pkgdesc="Library for the multimedia container format, and the native file and stream format ogg"
arch=(any)
url="https://www.xiph.org/ogg/"
license=('BSD-3-Clause')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("ogg-${pkgver}::git+https://github.com/xiph/ogg.git#commit=06a5e0262cdc28aa4ae6797627a783b5010440f0")
sha256sums=('SKIP')

prepare() {
    cd "ogg-${pkgver}"
    sed -i 's#@prefix@#/psp#' ogg.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' ogg.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' ogg.pc.in
    sed -i 's#@includedir@#${prefix}/include#' ogg.pc.in
}

build() {
    cd "ogg-${pkgver}"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "ogg-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    install -Dm644 ogg.m4 "$pkgdir/psp/share/aclocal/ogg.m4"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 COPYING "$pkgdir/psp/share/licenses/$pkgname"
}
