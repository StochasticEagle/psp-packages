pkgname=argtable2
pkgver=2.14
pkgrel=4
pkgdesc="Argtable is an ANSI C library for parsing GNU style command line options with a minimum of fuss"
arch=(any)
url="https://github.com/StochasticEagle/psp-argtable2"
license=('LGPL-2.0-or-later')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("argtable2-${pkgver}::git+https://github.com/StochasticEagle/psp-argtable2.git#commit=82a77bf8c03e398e5ce534057430cc678ed90e26")
sha256sums=('SKIP')

build() {
    cd "${pkgname}-${pkgver}"
    cmake -S . -B build \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE.md "$pkgdir/psp/share/licenses/$pkgname"
}
