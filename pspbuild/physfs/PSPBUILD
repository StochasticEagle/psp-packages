pkgname=physfs
pkgver=3.2.0
pkgrel=14
pkgdesc="PhysicsFS; a portable, flexible file i/o abstraction."
arch=(any)
url="https://icculus.org/physfs/"
license=('Zlib')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
provides=()
source=(
"${pkgname}-release-${pkgver}::git+https://github.com/icculus/physfs.git#commit=eb3383b532c5f74bfeb42ec306ba2cf80eed988c"
"psp.patch"
)
sha256sums=(
"SKIP"
"SKIP"
)

psp_apply_patch() {
    local patch_file="$1"
    shift
    local output
    if output="$(patch --dry-run --batch --forward --fuzz=0 "$@" < "$patch_file" 2>&1)"; then
        printf '%s\n' "$output"
        if grep -Eq 'with fuzz|offset -?[0-9]+ lines?' <<< "$output"; then
            echo "WARNING: patch drift detected: $patch_file" >&2
        fi
        patch --batch --forward --fuzz=0 "$@" < "$patch_file"
        return
    fi
    if patch --dry-run --batch --reverse --fuzz=0 "$@" < "$patch_file" >/dev/null 2>&1; then
        echo "Patch already applied: $patch_file"
        return 0
    fi
    printf '%s\n' "$output" >&2
    echo "ERROR: patch is incompatible with the current source: $patch_file" >&2
    return 1
}

prepare() {
    cd ${pkgname}-release-${pkgver}
    psp_apply_patch ../psp.patch -p1

    sed -e 's#@CMAKE_INSTALL_PREFIX@#/psp#' \
        -e 's#@CMAKE_INSTALL_FULL_LIBDIR@#${prefix}/lib#' \
        -e 's#@CMAKE_INSTALL_FULL_INCLUDEDIR@#${prefix}/include#' \
        -i extras/physfs.pc.in
}

build() {
    cd ${pkgname}-release-${pkgver}
    rm -rf pspbuild
    cmake --toolchain "${PSPDEV}/psp/share/pspdev.cmake" -S . -B pspbuild -Wno-author \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DPHYSFS_BUILD_TEST=Off \
        -DPHYSFS_ARCHIVE_SLB=Off \
        -DPHYSFS_BUILD_SHARED=Off \
        -DPHYSFS_BUILD_DOCS=Off \
        -DPHYSFS_ARCHIVE_ISO9660=Off \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 || { exit 1; }
    cmake --build pspbuild -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd ${pkgname}-release-${pkgver}
    DESTDIR="$pkgdir" cmake --install pspbuild || { exit 1; }
    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE.txt "$pkgdir/psp/share/licenses/$pkgname"
}
