pkgname=libxmp
pkgver=4.7.2
pkgrel=1
pkgdesc="Libxmp is a library that renders module files to PCM data"
arch=(any)
url="https://github.com/libxmp/libxmp"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
conflicts=('libxmp-lite')
source=("${pkgname}-${pkgver}::git+https://github.com/libxmp/libxmp.git#commit=a13276d27feabcf9ee4f982913f718ee05a65cb7")
sha256sums=('SKIP')

prepare() {
    cd "${pkgname}-${pkgver}"
    sed -i 's#@prefix@#/psp#' libxmp.pc.in
    sed -i 's#@exec_prefix@#${prefix}#' libxmp.pc.in
    sed -i 's#@libdir@#${prefix}/lib#' libxmp.pc.in
    sed -i 's#@includedir@#${prefix}/include#' libxmp.pc.in
}

build() {
    cd "${pkgname}-${pkgver}"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "${pkgname}-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 docs/COPYING "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 docs/CREDITS "$pkgdir/psp/share/licenses/$pkgname"
}
