pkgname=libyaml
pkgver=0.2.5
pkgrel=7
pkgdesc="LibYAML is a YAML parser and emitter library"
arch=(any)
url="https://pyyaml.org/wiki/LibYAML"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("${pkgname}-${pkgver}::git+https://github.com/yaml/libyaml.git#commit=90a56d4500aa1a1798514c5cb55c3ad4cb095f94")
sha256sums=('SKIP')

build() {
    cd "$pkgname-${pkgver}"
    cmake -S . -B build -Wno-dev \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build --parallel || { exit 1; }
}

package() {
    cd "$pkgname-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 License "$pkgdir/psp/share/licenses/$pkgname"
}
