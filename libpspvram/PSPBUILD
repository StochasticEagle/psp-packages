pkgname=libpspvram
pkgver=r11.885fd3f
pkgrel=7
pkgdesc="Dynamic VRAM allocation manager for the PSP"
arch=(any)
url="https://github.com/albe/libpspvram"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=("git+https://github.com/pspdev/libpspvram.git#commit=885fd3f5420dbc6a9ed450d268d752813093b417")
sha256sums=('SKIP')

build() {
    cd "$pkgname"
    rm -rf build
    cmake -Wno-author \
        -S . \
        -B build \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build build -- $MAKEFLAGS || { exit 1; }
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" cmake --install build || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 LICENSE "$pkgdir/psp/share/licenses/$pkgname"
}
