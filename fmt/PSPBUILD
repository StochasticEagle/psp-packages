pkgname=fmt
pkgver=12.2.0
pkgrel=2
pkgdesc="Open-source formatting library for C++"
arch=('any')
url="https://fmt.dev/"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
provides=()
conflicts=()
source=("$pkgname-$pkgver::git+https://github.com/fmtlib/fmt.git#tag=12.2.0")
sha256sums=("SKIP")

prepare() {
    cd "$pkgname-$pkgver"

    # Patch fmt.pc.in for the runtime PSP prefix rather than the staging path.
    sed -i 's/@CMAKE_INSTALL_PREFIX@/${PSPDEV}\/psp/' ./support/cmake/fmt.pc.in
}

build() {
    # psp-makepkg preserves src/ between invocations. Do not allow a CMake
    # cache generated for an older fmt source tree to survive a version bump.
    rm -rf build

    cmake -S "$pkgname-$pkgver" -B build \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DFMT_DOC=OFF \
        -DFMT_TEST=OFF \
        -DFMT_FUZZ=OFF \
        -DFMT_OS=OFF \
        -Wno-author
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 -t "$pkgdir"/psp/share/licenses/$pkgname "$pkgname-$pkgver/LICENSE"
}
