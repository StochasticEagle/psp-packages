pkgname=fmt
pkgver=12.1.0
pkgrel=2
pkgdesc="Open-source formatting library for C++"
arch=('any')
url="https://fmt.dev/"
license=('MIT')
groups=('psp-libraries')
depends=()
makedepends=()
provides=()
conflicts=()
source=("$pkgname-$pkgver::git+https://github.com/fmtlib/fmt.git#branch=main"
        "fmt-psp.patch")
sha256sums=("SKIP"
            "75aa63ff07bcb7dcf4275033c13f16a7a01d4024f3ff61b27b20f03dd233f200")

prepare() {
    cd "$pkgname-$pkgver"
    patch -p1 < ../fmt-psp.patch

    # patch fmt.pc.in
    sed -i 's/@CMAKE_INSTALL_PREFIX@/${PSPDEV}\/psp/' ./support/cmake/fmt.pc.in
}

build() {
	cmake -S $pkgname-$pkgver -B build \
        -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake \
		-DBUILD_SHARED_LIBS=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/psp \
        -DFMT_DOC=OFF \
        -DFMT_TEST=OFF \
        -DFMT_FUZZ=OFF \
        -DFMT_OS=OFF \
		-Wno-dev
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 -t "$pkgdir"/psp/share/licenses/$pkgname $pkgname-$pkgver/LICENSE
}
