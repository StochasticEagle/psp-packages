pkgname=googletest
pkgver=1.18.0
pkgrel=2
pkgdesc="GoogleTest - Google Testing and Mocking Framework"
arch=(any)
url="https://github.com/google/googletest"
license=('BSD-3-Clause')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=()
sha256sums=()

prepare() {
    rm -rf "$srcdir/$pkgname-$pkgver"
    cp -a "$startdir/../components/googletest" "$srcdir/$pkgname-$pkgver"
    rm -rf "$srcdir/$pkgname-$pkgver/.git"

    cd "$srcdir/$pkgname-$pkgver"

    # On the PSP/newlib ABI int32_t is long int, while GoogleTest's shard
    # printer uses %d for total_shards. Convert to int explicitly to match the
    # format argument type. The shard values are int32_t and PSP int is 32-bit.
    sed -i 's/GTEST_FLAG_GET(total_shards));/static_cast<int>(GTEST_FLAG_GET(total_shards)));/' googletest/src/gtest.cc

    sed -i 's#@CMAKE_INSTALL_FULL_LIBDIR@#${prefix}/lib#' googlemock/cmake/gmock_main.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_INCLUDEDIR@#${prefix}/include#' googlemock/cmake/gmock_main.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_LIBDIR@#${prefix}/lib#' googlemock/cmake/gmock.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_INCLUDEDIR@#${prefix}/include#' googlemock/cmake/gmock.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_LIBDIR@#${prefix}/lib#' googletest/cmake/gtest_main.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_INCLUDEDIR@#${prefix}/include#' googletest/cmake/gtest_main.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_LIBDIR@#${prefix}/lib#' googletest/cmake/gtest.pc.in
    sed -i 's#@CMAKE_INSTALL_FULL_INCLUDEDIR@#${prefix}/include#' googletest/cmake/gtest.pc.in
}

build() {
    cmake -Wno-dev \
        -S "$srcdir/$pkgname-$pkgver" \
        -B "$srcdir/$pkgname-$pkgver/build" \
        -DCMAKE_TOOLCHAIN_FILE=$PSPDEV/psp/share/pspdev.cmake \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_CXX_STANDARD=17 \
        -DCMAKE_CXX_STANDARD_REQUIRED=ON \
        -DCMAKE_CXX_FLAGS='-DGTEST_HAS_POSIX_RE=0' \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build "$srcdir/$pkgname-$pkgver/build" -- $MAKEFLAGS || { exit 1; }
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/$pkgname-$pkgver/build"

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/psp/share/licenses/$pkgname"
}
