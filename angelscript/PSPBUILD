pkgname=angelscript
pkgver=2.38.0
pkgrel=3
pkgdesc="A game-oriented interpreted compiled scripting language library"
arch=(any)
url="https://www.angelcode.com/angelscript/"
license=('Zlib')
groups=('psp-libraries')
depends=()
makedepends=()
optdepends=()
source=()
sha256sums=()

prepare() {
    rm -rf "${srcdir}/angelscript-${pkgver}"
    cp -a "${startdir}/../components/angelscript" "${srcdir}/angelscript-${pkgver}"
    rm -rf "${srcdir}/angelscript-${pkgver}/.git"
}

build() {
    # AngelScript's generic MIPS native-call backend still contains instructions
    # and argument packing that are not valid for the Allegrex FPU, notably
    # double-precision COP1 operations. Use AngelScript's supported portable
    # host-call path on PSP rather than compiling a native ABI stub that is not
    # safe for this processor. Applications must register host functions with
    # asCALL_GENERIC when using this build.
    CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-DAS_MAX_PORTABILITY" \
    cmake -S "${srcdir}/angelscript-${pkgver}/sdk/angelscript/projects/cmake" \
        -B "${srcdir}/angelscript-${pkgver}/build" \
        -Wno-author \
        -DCMAKE_TOOLCHAIN_FILE="$PSPDEV/psp/share/pspdev.cmake" \
        -DCMAKE_INSTALL_PREFIX=/psp \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.10 \
        "${XTRA_OPTS[@]}" || { exit 1; }
    cmake --build "${srcdir}/angelscript-${pkgver}/build" -- $MAKEFLAGS || { exit 1; }
}

package() {
    DESTDIR="$pkgdir" cmake --install "${srcdir}/angelscript-${pkgver}/build" || { exit 1; }

    mkdir -m 755 -p "$pkgdir/psp/share/licenses/$pkgname"
    install -m 644 "${srcdir}/angelscript-${pkgver}/sdk/docs/manual/doc_license.html" \
        "$pkgdir/psp/share/licenses/$pkgname/license.html"

    mkdir -p "$pkgdir/psp/share/doc/$pkgname"
    cp -r "${srcdir}/angelscript-${pkgver}/sdk/docs/." "$pkgdir/psp/share/doc/$pkgname/"
}
